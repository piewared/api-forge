"""{{entity_name}} repository for data access."""

from sqlmodel import Session, select

from .entity import {{entity_name}}
from .table import {{entity_name}}Table


# Server-managed columns that the repo must never overwrite from a domain
# entity. ``updated_at`` is omitted because the table's ``onupdate`` trigger
# refreshes it on flush.
_IMMUTABLE_FIELDS = frozenset({"id", "created_at"})


class {{entity_name}}Repository:
    """Data access layer for {{entity_name}} entities.

    Handles all database operations for {{entity_name}}s while keeping the
    data access logic colocated with the {{entity_name}} entity. Repositories
    never call ``commit()`` — the application service owns the unit of work.
    """

    def __init__(self, session: Session) -> None:
        self._session = session

    def get(self, {{entity_name.lower()}}_id: str) -> {{entity_name}} | None:
        """Get a {{entity_name.lower()}} by ID."""
        row = self._session.get({{entity_name}}Table, {{entity_name.lower()}}_id)
        if row is None:
            return None
        return {{entity_name}}.model_validate(row, from_attributes=True)

    def create(self, {{entity_name.lower()}}: {{entity_name}}) -> {{entity_name}}:
        """Persist a new {{entity_name.lower()}} and return it.

        Flushes so server-generated columns (server defaults, computed columns,
        triggers) are populated and constraint errors surface synchronously
        rather than at commit time. The returned entity reflects the row as
        the database sees it, not the input.
        """
        row = {{entity_name}}Table.model_validate({{entity_name.lower()}}, from_attributes=True)
        self._session.add(row)
        self._session.flush()
        self._session.refresh(row)
        return {{entity_name}}.model_validate(row, from_attributes=True)

    def update(self, {{entity_name.lower()}}: {{entity_name}}) -> {{entity_name}}:
        """Update an existing {{entity_name.lower()}}.

        Copies only mutable fields onto the persisted row — ``id`` and
        ``created_at`` are protected at the repo boundary so a stray service
        bug or external caller can't clobber them. ``updated_at`` is left to
        the table's ``onupdate`` trigger.
        """
        row = self._session.get({{entity_name}}Table, {{entity_name.lower()}}.id)
        if row is None:
            raise ValueError(f"{{entity_name}} with ID {{ "{" }}{{entity_name.lower()}}.id{{ "}" }} not found")

        for field, value in {{entity_name.lower()}}.model_dump().items():
            if field in _IMMUTABLE_FIELDS:
                continue
            setattr(row, field, value)

        self._session.flush()
        self._session.refresh(row)
        return {{entity_name}}.model_validate(row, from_attributes=True)

    def delete(self, {{entity_name.lower()}}_id: str) -> bool:
        """Delete a {{entity_name.lower()}} by ID. Returns True if deleted, False if not found."""
        row = self._session.get({{entity_name}}Table, {{entity_name.lower()}}_id)
        if row is None:
            return False
        self._session.delete(row)
        return True

    def list_all(self) -> list[{{entity_name}}]:
        """List all {{entity_name.lower()}}s."""
        rows = self._session.exec(select({{entity_name}}Table)).all()
        return [{{entity_name}}.model_validate(row, from_attributes=True) for row in rows]
