"""{{entity_name}} API router with CRUD operations."""

from fastapi import APIRouter, Depends, HTTPException, status
from sqlmodel import Session

{% if with_temporal %}
from src.app.api.http.deps import get_db_session, get_temporal_service
from src.app.core.services import TemporalClientService
{% else %}
from src.app.api.http.deps import get_db_session
{% endif %}
from .repository import {{entity_name}}Repository
from .schemas import {{entity_name}}Create, {{entity_name}}Read, {{entity_name}}Update
from .service import {{entity_name}}NotFoundError, {{entity_name}}Service


def get_{{entity_name.lower()}}_service(
    session: Session = Depends(get_db_session),
{%- if with_temporal %}
    temporal: TemporalClientService = Depends(get_temporal_service),
{%- endif %}
) -> {{entity_name}}Service:
    return {{entity_name}}Service(
        session,
        {{entity_name}}Repository(session),
{%- if with_temporal %}
        temporal,
{%- endif %}
    )


router = APIRouter(
    prefix="/api/v1/{{entity_name.lower()}}s",
    tags=["{{entity_name.lower()}}s"],
)


@router.post(
    "/",
    response_model={{entity_name}}Read,
    status_code=status.HTTP_201_CREATED,
)
def create_{{entity_name.lower()}}(
    data: {{entity_name}}Create,
    service: {{entity_name}}Service = Depends(get_{{entity_name.lower()}}_service),
) -> {{entity_name}}Read:
    """Create a new {{entity_name.lower()}}."""
    return service.create(data)


@router.get("/{{ "{" }}item_id{{ "}" }}", response_model={{entity_name}}Read)
def get_{{entity_name.lower()}}(
    item_id: str,
    service: {{entity_name}}Service = Depends(get_{{entity_name.lower()}}_service),
) -> {{entity_name}}Read:
    """Get a {{entity_name.lower()}} by ID."""
    result = service.get(item_id)
    if result is None:
        raise HTTPException(status_code=404, detail="{{entity_name}} not found")
    return result


@router.put("/{{ "{" }}item_id{{ "}" }}", response_model={{entity_name}}Read)
def update_{{entity_name.lower()}}(
    item_id: str,
    data: {{entity_name}}Update,
    service: {{entity_name}}Service = Depends(get_{{entity_name.lower()}}_service),
) -> {{entity_name}}Read:
    """Update a {{entity_name.lower()}} (partial update — only sent fields change)."""
    try:
        return service.update(item_id, data)
    except {{entity_name}}NotFoundError as e:
        raise HTTPException(status_code=404, detail=str(e)) from e


@router.delete("/{{ "{" }}item_id{{ "}" }}", status_code=status.HTTP_204_NO_CONTENT)
def delete_{{entity_name.lower()}}(
    item_id: str,
    service: {{entity_name}}Service = Depends(get_{{entity_name.lower()}}_service),
) -> None:
    """Delete a {{entity_name.lower()}}."""
    if not service.delete(item_id):
        raise HTTPException(status_code=404, detail="{{entity_name}} not found")


@router.get("/", response_model=list[{{entity_name}}Read])
def list_{{entity_name.lower()}}s(
    service: {{entity_name}}Service = Depends(get_{{entity_name.lower()}}_service),
) -> list[{{entity_name}}Read]:
    """List all {{entity_name.lower()}}s."""
    return service.list()
